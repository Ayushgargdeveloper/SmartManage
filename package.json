{
  "name": "workpulse-ai",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered daily work progress and team intelligence platform.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @workpulse/web",
    "dev:web": "npm run dev --workspace @workpulse/web",
    "dev:api": "npm run start:dev --workspace @workpulse/api",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate --workspace @workpulse/api",
    "db:validate": "npm run db:validate --workspace @workpulse/api",
    "db:migrate": "npm run db:migrate --workspace @workpulse/api",
    "db:seed": "npm run db:seed --workspace @workpulse/api",
    "postinstall": "npm run db:generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.4",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  }
}
